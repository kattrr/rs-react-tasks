#!/bin/sh
# Start of the pre-commit hook

# Color codes for terminal output
CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
BOLD='\033[1m'
RESET='\033[0m'

# Start message
echo "${CYAN}${BOLD}🔧 Husky pre-commit hook is running...${RESET}"

# get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | sed 's| |\\ |g')

if [ -n "$STAGED_FILES" ]; then
    echo "${CYAN}Formateando archivos staged...${RESET}"
    npm run format:fix
    FORMAT_STATUS=$?
    if [ $FORMAT_STATUS -ne 0 ]; then
        echo "${RED}${BOLD}❌ Error al formatear archivos (npm run format:fix)!${RESET}"
        exit 1
    fi
    echo "${CYAN}Corriendo linter...${RESET}"
    npm run lint
    LINT_STATUS=$?
    if [ $LINT_STATUS -ne 0 ]; then
        echo "${RED}${BOLD}❌ Linter encontró errores. Intentando corregir con lint:fix...${RESET}"
        npm run lint:fix
        LINT_FIX_STATUS=$?
        if [ $LINT_FIX_STATUS -ne 0 ]; then
            echo "${RED}${BOLD}❌ Lint:fix no pudo corregir todos los errores.${RESET}"
            exit 1
        fi
        echo "${GREEN}${BOLD}✅  Lint:fix aplicó correcciones exitosamente.${RESET}"
    else
        echo "${GREEN}${BOLD}✅  Linter pasó sin errores.${RESET}"
    fi
else
    echo "${CYAN}No hay archivos staged para formatear o lint.${RESET}"
fi

# End message
echo "${GREEN}${BOLD}✅  Husky pre-commit hook completed successfully!${RESET}"